+async function refresh(){try{const r=await fetch('/modsearch/traffic?data=1',{cache:'no-store'});if(!r.ok)throw Error(r.status);const d=await r.json(),a=d.entries||[],up=a.reduce((s,x)=>s+x.uploadBytes,0),down=a.reduce((s,x)=>s+x.downloadBytes,0),ok=a.filter(x=>x.ok).length;$('up').textContent=fmt(up);$('down').textContent=fmt(down);$('calls').textContent=a.length;$('rate').textContent=(a.length?ok/a.length*100:0).toFixed(1)+'%';$('live').textContent='● 实时更新 · '+new Date().toLocaleTimeString();const groups={};for(const x of a){const g=groups[x.engine]??(groups[x.engine]={n:0,u:0,d:0,ok:0});g.n++;g.u+=x.uploadBytes;g.d+=x.downloadBytes;if(x.ok)g.ok++}$('engines').innerHTML=Object.entries(groups).map(([k,v])=>'<tr><td>'+esc(k)+'</td><td>'+v.n+'</td><td>'+fmt(v.u)+'</td><td>'+fmt(v.d)+'</td><td>'+(v.ok/v.n*100).toFixed(1)+'%</td></tr>').join('')||'<tr><td colspan="5">暂无请求数据</td></tr>';$('recent').innerHTML=a.slice(-20).reverse().map(x=>'<tr><td>'+new Date(x.at).toLocaleString()+'</td><td>'+esc(x.engine)+'</td><td>'+fmt(x.uploadBytes)+'</td><td>'+fmt(x.downloadBytes)+'</td><td>'+(x.status??'—')+'</td><td class="'+(x.ok?'ok':'bad')+'">'+(x.ok?'成功':'失败')+'</td></tr>').join('')||'<tr><td colspan="6">暂无记录</td></tr>';const vals=a.slice(-30).map(x=>x.downloadBytes),max=Math.max(1,...vals),pts=vals.map((v,i)=>(vals.length<2?450:i*900/(vals.length-1))+','+(205-v/max*185)).join(' ');$('chart').innerHTML='<polyline points="'+pts+'" fill="none" stroke="#27d98b" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>'; }catch(e){$('live').textContent='● 连接失败 · '+e.message}}
+function $(id){return document.getElementById(id)}function esc(s){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}refresh();setInterval(refresh,2000);
+</script></html>`;
+      res.writeHead(200, { 'content-type': 'text/html; charset=utf-8', 'cache-control': 'no-store' });
